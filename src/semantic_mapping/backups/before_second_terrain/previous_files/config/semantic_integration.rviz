Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Occupied semantic voxels
      Enabled: true
      Topic:
        Value: /semantic_voxel_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Style: Boxes
      Size (m): 0.35
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Decay Time: 0
    - Class: rviz_default_plugins/Pose
      Name: Vehicle pose
      Enabled: true
      Topic:
        Value: /vehicle_pose
      Shape: Arrow
      Color: 255; 25; 0
      Alpha: 1
      Shaft Length: 2
      Shaft Radius: 0.1
      Head Length: 0.5
      Head Radius: 0.25
    - Class: rviz_default_plugins/Image
      Name: Camera reference
      Enabled: true
      Topic:
        Value: /pylon_camera_node/image_color
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Predicted terrain classes
      Enabled: true
      Topic:
        Value: /camera_semantic_voxel/segmentation_image
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Projection alignment reference
      Enabled: false
      Topic:
        Value: /camera_semantic_voxel/projection_image
        Reliability Policy: Best Effort
        Depth: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 22
      Focal Point: {X: 0, Y: 0, Z: 0}
      Yaw: 0.7
      Pitch: 0.56
Window Geometry:
  Width: 1280
  Height: 800
