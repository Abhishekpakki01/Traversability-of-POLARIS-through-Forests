# EXPLORE layout: whole map, free orbit around the map centre (Target Frame sensor_init),
# no image panels so the Displays list is fully visible. Derived from demo_v2.rviz.
# Colours: brown ground, light green low vegetation, dark green tall vegetation,
# violet trunk-like, red solid, gray unknown; bright blue water (camera + no LiDAR return),
# light blue camera-only water. Clouds use Volatile durability (ros2 bag play).
Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 600
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
