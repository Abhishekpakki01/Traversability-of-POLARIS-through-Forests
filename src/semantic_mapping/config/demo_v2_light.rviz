# LIGHT v2 layout for software (CPU) rendering: flat squares instead of boxes.
# v2 demo layout (0.2 m voxels, 20 m range), derived from water_demo.rviz (unchanged).
# LiDAR-only classes plus water: camera water pixels projected onto the mapped
# ground. Bright blue = camera water + no LiDAR return; light blue = camera-only (doubtful).
# All /lidar, /terrain and /water clouds must use Volatile durability.
# Default LiDAR display is a 15 m crop updated at 2 Hz (offline_demo_view) to keep RViz responsive.
Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 300
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Traversability, camera semantics only (optional)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.2
    Style: Flat Squares
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /terrain/traversability
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
